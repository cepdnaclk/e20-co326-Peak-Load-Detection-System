[
  {
    "id": "peak-flow",
    "type": "tab",
    "label": "Peak Load Detection",
    "disabled": false,
    "info": "Real-time monitoring of industrial peak load with fan control"
  },
  {
    "id": "mqtt-broker-config",
    "type": "mqtt-broker",
    "name": "Course MQTT Broker",
    "broker": "localhost",
    "port": "1883",
    "clientid": "group25-nodered",
    "usetls": false,
    "compatmode": false,
    "keepalive": "60",
    "cleansession": true
  },
  {
    "id": "ui-tab-main",
    "type": "ui_tab",
    "name": "Dashboard",
    "icon": "dashboard",
    "order": 1,
    "disp": true
  },
  {
    "id": "ui-group-realtime",
    "type": "ui_group",
    "name": "Real-Time Monitor",
    "tab": "ui-tab-main",
    "order": 1,
    "disp": true,
    "width": "12",
    "collapse": false
  },
  {
    "id": "ui-group-graph",
    "type": "ui_group",
    "name": "Load History",
    "tab": "ui-tab-main",
    "order": 2,
    "disp": true,
    "width": "12",
    "collapse": false
  },
  {
    "id": "ui-group-alerts",
    "type": "ui_group",
    "name": "Alerts & Status",
    "tab": "ui-tab-main",
    "order": 3,
    "disp": true,
    "width": "12",
    "collapse": false
  },
  {
    "id": "mqtt-in-data",
    "type": "mqtt in",
    "z": "peak-flow",
    "name": "Sensor Data Input",
    "topic": "sensors/group25/peak/data",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt-broker-config",
    "x": 140,
    "y": 80,
    "wires": [["fn-process-data"]]
  },
  {
    "id": "fn-process-data",
    "type": "function",
    "z": "peak-flow",
    "name": "Process Sensor Data",
    "func": "let payload = msg.payload;\nlet processed = {\n  timestamp: payload.timestamp || new Date().toISOString(),\n  power_kw: parseFloat(payload.power_kw || 0),\n  power_w: parseFloat(payload.power_w || payload.power_kw * 1000 || 0),\n  state: payload.state || payload.mode || 'unknown',\n  is_peak: payload.is_peak || (payload.mode === 'peak')\n};\nlet gauge_msg = { payload: processed.power_w, topic: 'Power (W)' };\nlet chart_msg = { payload: { power_w: processed.power_w, state: processed.state, is_peak: processed.is_peak }, topic: 'chart' };\nlet status_msg = { payload: processed };\nlet fan_msg = { payload: processed.state === 'PEAK' ? '🔴 FAN OFF' : '🟢 FAN RUNNING' };\nreturn [gauge_msg, chart_msg, status_msg, fan_msg];",
    "outputs": 4,
    "noerr": 0,
    "x": 380,
    "y": 80,
    "wires": [["ui-gauge-load"], ["ui-chart-load"], ["fn-color-status"], ["ui-template-fan"]]
  },
  {
    "id": "ui-gauge-load",
    "type": "ui_gauge",
    "z": "peak-flow",
    "name": "Current Load",
    "group": "ui-group-realtime",
    "order": 1,
    "width": "4",
    "height": "4",
    "label": "Current Load (W)",
    "format": "{{value | number:2}}",
    "min": "0",
    "max": "5",
    "seg1": "1.5",
    "seg2": "3",
    "x": 600,
    "y": 40,
    "wires": []
  },
  {
    "id": "ui-template-fan",
    "type": "ui_template",
    "z": "peak-flow",
    "group": "ui-group-realtime",
    "name": "Fan Animation",
    "order": 2,
    "width": "4",
    "height": "4",
    "format": "<div style='display:flex; flex-direction:column; align-items:center; justify-content:center; height:100%; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 10px; padding: 20px;'>\n  <svg id='fan-icon' width='80' height='80' viewBox='0 0 100 100' style='margin-bottom: 10px;'>\n    <!-- Fan blades -->\n    <g id='fan-blades'>\n      <ellipse cx='50' cy='30' rx='12' ry='20' fill='#FFD700' opacity='0.8'/>\n      <ellipse cx='70' cy='50' rx='20' ry='12' fill='#FFD700' opacity='0.8' transform='rotate(90 50 50)'/>\n      <ellipse cx='50' cy='70' rx='12' ry='20' fill='#FFD700' opacity='0.8' transform='rotate(180 50 50)'/>\n      <ellipse cx='30' cy='50' rx='20' ry='12' fill='#FFD700' opacity='0.8' transform='rotate(270 50 50)'/>\n    </g>\n    <!-- Fan center -->\n    <circle cx='50' cy='50' r='8' fill='#333'/>\n  </svg>\n  <div style='font-size: 18px; font-weight: bold; color: white; text-align: center;'>Fan Status</div>\n  <div id='fan-state' style='font-size: 24px; font-weight: bold; margin-top: 10px; color: #00FF00;'>🟢 RUNNING</div>\n</div>\n\n<style>\n  @keyframes spin-fast {\n    from { transform: rotate(0deg); }\n    to { transform: rotate(360deg); }\n  }\n  @keyframes spin-slow {\n    from { transform: rotate(0deg); }\n    to { transform: rotate(10deg); }\n  }\n  #fan-blades.running {\n    animation: spin-fast 0.6s linear infinite;\n  }\n  #fan-blades.stopped {\n    animation: spin-slow 2s ease-in-out infinite;\n  }\n</style>\n\n<script>\n  const fanIcon = document.getElementById('fan-blades');\n  const fanState = document.getElementById('fan-state');\n  \n  scope.$watch('msg.payload', function(newVal) {\n    if (newVal) {\n      if (newVal === '🟢 FAN RUNNING' || newVal === 'NORMAL') {\n        fanIcon.classList.remove('stopped');\n        fanIcon.classList.add('running');\n        fanState.textContent = '🟢 RUNNING';\n        fanState.style.color = '#00FF00';\n      } else {\n        fanIcon.classList.remove('running');\n        fanIcon.classList.add('stopped');\n        fanState.textContent = '🔴 STOPPED';\n        fanState.style.color = '#FF0000';\n      }\n    }\n  });\n</script>",
    "storeOutMessages": true,
    "fwdInMessages": true,
    "resendOnRefresh": true,
    "templateScope": "local",
    "x": 600,
    "y": 100,
    "wires": [[]]
  },
  {
    "id": "fn-color-status",
    "type": "function",
    "z": "peak-flow",
    "name": "Status Color",
    "func": "let state = msg.payload.state.toUpperCase();\nlet color = '#21ba45';\nlet display = '✓ NORMAL';\nif (state === 'PEAK') {\n  color = '#db2828';\n  display = '⚠ PEAK DETECTED';\n} else if (state === 'WARNING') {\n  color = '#fbbd08';\n  display = '⚡ WARNING';\n}\nmsg.payload = display;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 680,
    "y": 160,
    "wires": [["ui-text-status"]]
  },
  {
    "id": "ui-text-status",
    "type": "ui_text",
    "z": "peak-flow",
    "name": "Status Text",
    "group": "ui-group-realtime",
    "order": 3,
    "width": "4",
    "height": "4",
    "label": "System Status",
    "format": "{{msg.payload}}",
    "x": 880,
    "y": 160,
    "wires": []
  },
  {
    "id": "ui-chart-load",
    "type": "ui_chart",
    "z": "peak-flow",
    "name": "Load Over Time",
    "group": "ui-group-graph",
    "order": 1,
    "width": "12",
    "height": "6",
    "label": "Power Load History (W)",
    "chartType": "line",
    "legend": "true",
    "xformat": "HH:mm:ss",
    "ysingle": false,
    "y1label": "Power (W)",
    "y1min": "0",
    "y1max": "5",
    "removeOlder": 30,
    "removeOlderUnit": "60",
    "x": 600,
    "y": 200,
    "wires": [[], []]
  },
  {
    "id": "mqtt-in-alerts",
    "type": "mqtt in",
    "z": "peak-flow",
    "name": "Peak Alerts",
    "topic": "alerts/group25/peak/status",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt-broker-config",
    "x": 140,
    "y": 280,
    "wires": [["fn-format-alert"]]
  },
  {
    "id": "fn-format-alert",
    "type": "function",
    "z": "peak-flow",
    "name": "Format Alert",
    "func": "let p = msg.payload;\nlet power = (p.power_w || p.power_kw * 1000).toFixed(2);\nlet time = p.timestamp || new Date().toISOString();\nmsg.payload = '🔴 PEAK DETECTED\\n' + power + ' W @ ' + time;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 380,
    "y": 280,
    "wires": [["ui-text-alert"]]
  },
  {
    "id": "ui-text-alert",
    "type": "ui_text",
    "z": "peak-flow",
    "group": "ui-group-alerts",
    "order": 1,
    "width": "12",
    "height": "3",
    "name": "Alert Display",
    "label": "Latest Alert",
    "format": "{{msg.payload}}",
    "x": 630,
    "y": 280,
    "wires": []
  }
]
