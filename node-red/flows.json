[
  {
    "id": "peak-flow",
    "type": "tab",
    "label": "Peak Load Detection",
    "disabled": false,
    "info": ""
  },
  {
    "id": "mqtt-broker-config",
    "type": "mqtt-broker",
    "name": "Course MQTT Broker",
    "broker": "localhost",
    "port": "1883",
    "clientid": "group25-nodered",
    "usetls": false,
    "compatmode": false,
    "keepalive": "60",
    "cleansession": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthPayload": "",
    "closeTopic": "",
    "closeQos": "0",
    "closePayload": "",
    "willTopic": "",
    "willQos": "0",
    "willPayload": ""
  },
  {
    "id": "ui-group-main",
    "type": "ui_group",
    "name": "Peak Load Monitor",
    "tab": "ui-tab-main",
    "order": 1,
    "disp": true,
    "width": "12",
    "collapse": false
  },
  {
    "id": "ui-tab-main",
    "type": "ui_tab",
    "name": "Dashboard",
    "icon": "dashboard",
    "order": 1,
    "disp": true
  },
  {
    "id": "mqtt-in-data",
    "type": "mqtt in",
    "z": "peak-flow",
    "name": "Load Data",
    "topic": "sensors/group25/peak/data",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt-broker-config",
    "x": 140,
    "y": 80,
    "wires": [["fn-extract-load"]]
  },
  {
    "id": "fn-extract-load",
    "type": "function",
    "z": "peak-flow",
    "name": "Extract power_kw",
    "func": "msg.payload = msg.payload.power_kw;\nmsg.topic = 'Power (kW)';\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 360,
    "y": 80,
    "wires": [["ui-chart-load", "ui-gauge-load"]]
  },
  {
    "id": "ui-chart-load",
    "type": "ui_chart",
    "z": "peak-flow",
    "name": "Load Chart",
    "group": "ui-group-main",
    "order": 1,
    "width": 0,
    "height": 0,
    "label": "Power Load (kW)",
    "chartType": "line",
    "legend": "false",
    "x": 600,
    "y": 60,
    "wires": [[], []]
  },
  {
    "id": "ui-gauge-load",
    "type": "ui_gauge",
    "z": "peak-flow",
    "name": "Current Load",
    "group": "ui-group-main",
    "order": 2,
    "width": 0,
    "height": 0,
    "label": "Current Load (kW)",
    "format": "{{value}}",
    "min": 0,
    "max": 900,
    "x": 600,
    "y": 120,
    "wires": []
  },
  {
    "id": "mqtt-in-alerts",
    "type": "mqtt in",
    "z": "peak-flow",
    "name": "Peak Alerts",
    "topic": "alerts/group25/peak/status",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt-broker-config",
    "x": 140,
    "y": 180,
    "wires": [["fn-format-alert"]]
  },
  {
    "id": "fn-format-alert",
    "type": "function",
    "z": "peak-flow",
    "name": "Format Alert Text",
    "func": "var p = msg.payload;\nmsg.payload = 'PEAK DETECTED: ' + p.power_kw + ' kW @ ' + p.timestamp;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 380,
    "y": 180,
    "wires": [["ui-text-alert"]]
  },
  {
    "id": "ui-text-alert",
    "type": "ui_text",
    "z": "peak-flow",
    "group": "ui-group-main",
    "order": 3,
    "width": 0,
    "height": 0,
    "name": "Alert Text",
    "label": "Alerts",
    "format": "{{msg.payload}}",
    "x": 630,
    "y": 180,
    "wires": []
  }
]
