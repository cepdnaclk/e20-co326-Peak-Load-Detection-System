### Example environment variables for docker-compose
# Copy to .env and edit as needed for your environment

# MQTT broker (use service name 'mqtt-broker' for local compose)
MQTT_HOST=mqtt-broker
MQTT_PORT=1883

# Group / project identifiers
GROUP_ID=group25
PROJECT_ID=peak

# Detection tuning (units in kW or W as used by your code)
# For this repo the code expects PEAK_THRESHOLD_W (default shown here)
PEAK_THRESHOLD_W=1.5
WARNING_RATIO=0.867
RELAY_RESTORE_DELAY_S=8

# Node-RED / Mosquitto exposed ports (for local run)
MQTT_EXTERNAL_PORT=1883
NODE_RED_PORT=1880
